# کلید Gemini — از https://aistudio.google.com/apikey بگیر
GEMINI_API_KEY=

# اختیاری: مدل دلخواه (پیش‌فرض gemini-2.5-flash با زنجیره جایگزین)
# GEMINI_MODEL=gemini-2.5-flash

# اختیاری: سقف درخواست در ساعت برای هر IP (پیش‌فرض ۳۰)
# RATE_LIMIT_PER_HOUR=30

# اختیاری ولی لازم برای دیپلوی روی اینترنت:
# رمز دسترسی. اگر ست شود، هیچ‌کس بدون رمز نمی‌تواند تحلیل بزند.
# ACCESS_CODE=

# پورت (پیش‌فرض ۳۰۰۰). روی Render/Railway خودش ست می‌شود.
# PORT=3000

# سقف تعداد عکس در هر درخواست در کد ثابت است (۱۵ عکس، متغیر MAX_IMAGES در server.js)
